# Sentiment Trading Alpha - Environment Variables
# Copy this file to .env and configure as needed
# Never commit your actual .env file - it's already in .gitignore

# ==========================================
# LLM Configuration (Cloud Mode)
# ==========================================

# Choose your cloud LLM provider: "openai", "openrouter", "anthropic", "google", or "custom"
INFERENCE_BACKEND=openai

# OpenAI-compatible API configuration
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Example configurations for different providers:
# OpenAI:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o-mini
#
# OpenRouter (access 200+ models):
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=openai/gpt-4o-mini
#
# Anthropic (via OpenAI-compatible API):
#   OPENAI_BASE_URL=https://api.anthropic.com/v1
#   OPENAI_MODEL=claude-3-5-sonnet-20241022
#
# Google Gemini (via OpenAI-compatible API):
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_MODEL=gemini-1.5-flash

# ==========================================
# LLM Configuration (Local Mode - Ollama)
# ==========================================

# Ollama model override (if unset, uses whichever model Ollama is currently serving)
OLLAMA_MODEL=qwen3.5:9b

# Ollama API URL
OLLAMA_URL=http://localhost:11434/api/generate

# ==========================================
# Security
# ==========================================

# Admin API token - protects sensitive routes (config, trades, Alpaca)
# Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=your-secure-admin-token-here

# ==========================================
# Optional: Data Sources
# ==========================================

# FRED API key for free economic data (recommended for better signals)
# Get your free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key-here

# ==========================================
# Optional: Telegram Notifications
# ==========================================

# Telegram bot token for notifications and remote control
# Stored in OS keychain when set via Admin UI
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ==========================================
# Optional: System Configuration
# ==========================================

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# LLM analysis timeout in seconds
ANALYSIS_MAX_SECONDS=300

# Grace period for ingestion worker startup (seconds)
INGESTION_STARTUP_GRACE_SECONDS=20

# ==========================================
# Debug/Development
# ==========================================

# Enable verbose/debug logging
# Set to "1" to enable
VERBOSE=0
