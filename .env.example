# ═══════════════════════════════════════════════════════════════
#  Sentiment Trading Alpha — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# 1. Copy this file:  cp .env.example .env
# 2. Edit the values below
# 3. Run:              docker compose up --build
#
# Docker Compose auto-loads .env — no extra flags needed.
# The app reads these via os.getenv() — zero code changes required.
# ═══════════════════════════════════════════════════════════════

# ── Server Bindings ──────────────────────────────────────────────
# Host the backend listens on (0.0.0.0 = all interfaces in Docker)
HOST=0.0.0.0
PORT=8000

# ── Database ─────────────────────────────────────────────────────
# SQLite files stored in /data (Docker volume "trading-data")
DATABASE_URL=sqlite:////data/trading_system.db
DECISION_LOG_DATABASE_URL=sqlite:////data/decision_log.db

# ── CORS ─────────────────────────────────────────────────────────
# Allowed origins (comma-separated, no spaces)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── LLM / Inference Backend ──────────────────────────────────────
# Choose one: openai | ollama | vllm
INFERENCE_BACKEND=openai

# ── OpenAI (or any OpenAI-compatible API) ────────────────────────
# Get a key: https://platform.openai.com/api-keys
# Format: sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Alternative Cloud Providers (uncomment ONE) ────────────────
# OpenRouter (access 200+ models)
#OPENAI_API_KEY=sk-or-v1-your-openrouter-key
#OPENAI_BASE_URL=https://openrouter.ai/api/v1
#OPENAI_MODEL=google/gemma-4-31b-it:free

# Anthropic (via OpenAI-compatible API)
#OPENAI_API_KEY=sk-ant-your-key
#OPENAI_BASE_URL=https://api.anthropic.com/v1
#OPENAI_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (via OpenAI-compatible API)
#OPENAI_API_KEY=your-gemini-api-key
#OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#OPENAI_MODEL=gemini-2.0-flash

# Custom OpenAI-compatible endpoint
#OPENAI_API_KEY=your-key
#OPENAI_BASE_URL=https://your-custom-endpoint/v1
#OPENAI_MODEL=your-model-name

# ── Ollama (local LLM — alternative to OpenAI) ──────────────────
# Run Ollama on your Mac: brew install ollama && ollama serve
# Then: ollama pull llama3
# In Docker, use host.docker.internal to reach your Mac
# NOTE: Only enable ONE backend (openai OR ollama OR vllm)
#OLLAMA_URL=http://host.docker.internal:11434
#OLLAMA_MODEL=llama3

# ── vLLM (self-hosted LLM — alternative to OpenAI) ──────────────
#VLLM_URL=http://localhost:8000/v1

# ── FRED Economic Data ───────────────────────────────────────────
# Get a (free) key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key-here

# ── Telegram Notifications (optional) ────────────────────────────
# Leave blank to disable
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Admin API Token ──────────────────────────────────────────────
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=change-me-to-a-secure-random-string

# ── Frontend ─────────────────────────────────────────────────────
# Points to the backend API. Inside Docker both run on localhost.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Tuning (optional — usually leave defaults) ───────────────────
VERBOSE=0
UVICORN_RELOAD=false
ANALYSIS_MAX_SECONDS=300
INGESTION_STARTUP_GRACE_SECONDS=10
